<mah:MetroWindow x:Class="_3dZipSorter.UI.MainWindow"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3dZipSorter.UI"
        mc:Ignorable="d"
        xmlns:metro="http://schemas.metro.mahapps.com/winfx/xaml/controls"
        Title="3dZipSorter" Height="450" Width="800">
    <Grid>
        <TabControl>
            <!-- Onglet 1 : Interface actuelle -->
            <TabItem Header="Accueil">
                <Grid>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <!-- Contenu extensible -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ComboBox pour sélectionner le mode -->
                        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Mode de fonctionnement :</Label>
                        <ComboBox x:Name="ModeSelector"
                  Grid.Row="0" Grid.Column="1"
                  HorizontalAlignment="Left"
                  Width="200"
                  Background="Azure"
                  BorderBrush="Black"
                  SelectionChanged="ModeSelector_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="SelecteurFonctionOrganisation"
          Grid.Row="0" Grid.Column="1"
          Visibility="Collapsed"
          HorizontalAlignment="right"
          Width="200"          
          Background="Azure"
          BorderBrush="Black"        
          SelectionChanged="SelecteurFonctionOrganisation_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="ActionButton" Grid.Row="0" Grid.Column="2" Margin="5" Content="lets go" Click="Action_Click" Visibility="Collapsed">
                        </Button>
                        <!-- Label et champ pour le dossier source -->
                        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Dossier Source :</Label>
                        <TextBox x:Name="SourceTextBox" Grid.Row="1" Grid.Column="1" Width="300" Margin="5" />
                        <Button Grid.Row="1" Grid.Column="2" Margin="5" Content="Parcourir" Click="BrowseSource_Click" />

                        <!-- Label et champ pour le dossier destination -->
                        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Dossier Destination :</Label>
                        <TextBox x:Name="DestinationTextBox" Grid.Row="2" Grid.Column="1" Width="300" Margin="5" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="5" Content="Parcourir" Click="BrowseDestination_Click" />

                        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Résultats :</Label>
                        <ListView x:Name="LogListView" Grid.Row="4" Grid.Column="1" Background="Black">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="LimeGreen"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                </Grid>
            </TabItem>

            <!-- Onglet 2 : Paramètres 
            <TabItem Header="Paramètre">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*"/>
                        <ColumnDefinition Width="376*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2">
                        <TextBlock Text="Paramètres de l'application" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                        
                        <TextBlock Text="Chemin des extensions de fichier :" />
                        <TextBox x:Name="FileExtensionsPathTextBox" Text="{Binding FileExtensionsPath}" />
                        <Button Content="Enregistrer les paramètres" Click="SaveSettings_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>-->
            
            <!-- Onglet 3 : Paramétres -->
            <TabItem Header="Paramètres">
                    <StackPanel Margin="10">
                        <TextBlock Text="Paramètres de l'application" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                        <TabControl>
                            <TabItem Header="archives">
                            <StackPanel Margin="10">
                                <!-- Section pour les règles de tri des archives -->
                                    <TextBlock Text="Règles de tri des archives" FontWeight="Bold" FontSize="14" Margin="0,10,0,5" />
                                <Button Content="Charger un fichier JSON" Click="LoadArchiveSortingRules_Click" Margin="0,0,0,5" />
                                <ListView x:Name="ArchiveSortingRulesListView" Height="150" Margin="0,0,0,10">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Extension" DisplayMemberBinding="{Binding extension}" Width="150" />
                                            <GridViewColumn Header="Catégorie" DisplayMemberBinding="{Binding category}" Width="200" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBox x:Name="ArchiveExtensionTextBox" Width="150" Margin="0,0,5,0" Text="{Binding extension}" />
                                    <TextBox x:Name="ArchiveCategoryTextBox" Width="200" Margin="0,0,5,0" Text="{Binding category}" />
                                    <Button Content="Ajouter/Modifier" Click="AddOrUpdateArchiveSortingRule_Click" />
                                </StackPanel>
                            </StackPanel>
                            </TabItem>
                            
                            <TabItem Header="dossier">
                                    <!-- Section pour les règles de tri des fichiers -->
                                <StackPanel Margin="10">
                                    <TextBlock Text="Règles de tri des fichiers" FontWeight="Bold" FontSize="14" Margin="0,10,0,5" />
                                    <Button Content="Charger un fichier JSON" Click="LoadFileSortingRules_Click" Margin="0,0,0,5" />
                                    <ListView x:Name="FileSortingRulesListView" Height="150" Margin="0,0,0,10">
                                        <ListView.View>
                                            <GridView>
                                             <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding nom}" Width="150" />
                                            <GridViewColumn Header="Catégorie" DisplayMemberBinding="{Binding category}" Width="200" />
                                            <GridViewColumn Header="Cible" DisplayMemberBinding="{Binding cible}" Width="200" />
                                        </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="FileNomTextBox" Width="150" Margin="0,0,5,0" Text="{Binding nom}" />
                                        <TextBox x:Name="FileCategoryTextBox" Width="200" Margin="0,0,5,0" Text="{Binding category}" />
                                        <TextBox x:Name="FileCibleTextBox" Width="200" Margin="0,0,5,0" Text="{Binding cible}" />
                                    <Button Content="Ajouter/Modifier" Click="AddOrUpdateFileSortingRule_Click" />
                                    </StackPanel>
                            </StackPanel>
                        </TabItem>
                        </TabControl> 
                    </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</mah:MetroWindow>
 